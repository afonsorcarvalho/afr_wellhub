<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_wellhub_signup_activation" model="mail.template">
            <field name="name">Wellhub: confirmar inscrição de colaborador</field>
            <field name="model_id" ref="model_wellhub_collaborator"/>
            <field name="subject">Confirme sua inscrição Wellhub</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted or '' }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="description">Enviado após o cadastro no formulário público de inscrição.</field>
            <field name="body_html" type="html">
<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif; line-height: 1.6; color: #2c3e50; max-width: 600px; margin: 0 auto;">
    <!-- Cabeçalho com cor -->
    <div style="background: linear-gradient(135deg, #714B67 0%, #5a3d52 100%); padding: 32px 24px; text-align: center; border-radius: 8px 8px 0 0;">
        <h1 style="margin: 0; color: #fff; font-size: 28px; font-weight: 600;">Bem-vindo ao Wellhub!</h1>
    </div>

    <!-- Corpo principal -->
    <div style="background: #fff; padding: 32px 24px; border: 1px solid #e8eef2; border-top: none;">
        <p style="margin: 0 0 20px 0; font-size: 16px;">
            Olá <strong><t t-out="object.name or ''"/></strong>,
        </p>

        <p style="margin: 0 0 24px 0; font-size: 15px; color: #555;">
            Parabéns! Sua inscrição foi recebida com sucesso. Agora é preciso confirmar o seu e-mail para ativar o acesso ao benefício Wellhub.
        </p>

        <!-- Box de benefícios -->
        <div style="background: #f8fafc; border-left: 4px solid #714B67; padding: 16px; margin: 24px 0; border-radius: 4px; font-size: 14px;">
            <p style="margin: 0; font-weight: 600; color: #714B67; margin-bottom: 8px;">O que você ganha com Wellhub:</p>
            <ul style="margin: 0; padding-left: 20px; color: #555;">
                <li style="margin-bottom: 6px;">Acesso a academias e estúdios de fitness</li>
                <li style="margin-bottom: 6px;">Apps de bem-estar e mindfulness</li>
                <li>Descontos exclusivos em todo o Brasil</li>
            </ul>
        </div>

        <!-- CTA Principal -->
        <div style="text-align: center; margin: 32px 0;">
            <a t-att-href="object.signup_mail_activation_url"
               style="background: linear-gradient(135deg, #714B67 0%, #5a3d52 100%); color: #fff; padding: 16px 48px; text-decoration: none; border-radius: 6px; display: inline-block; font-weight: 600; font-size: 16px; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(113, 75, 103, 0.3);">
                ✓ Confirmar e-mail agora
            </a>
        </div>

        <!-- Urgência -->
        <div style="background: #fff3cd; border: 1px solid #ffc107; border-radius: 6px; padding: 16px; margin: 24px 0; font-size: 14px; color: #856404;">
            <strong>⏰ Atenção:</strong> O link de confirmação expira em <strong>48 horas</strong>. Ative sua inscrição em breve!
        </div>

        <!-- Instruções alternativas -->
        <p style="margin: 24px 0; font-size: 13px; color: #777;">
            Se o botão não funcionar, copie e cole este link no seu navegador:<br/>
            <code style="background: #f5f5f5; padding: 8px; display: inline-block; border-radius: 4px; word-break: break-all; margin-top: 8px;">
                <t t-out="object.signup_mail_activation_url or ''"/>
            </code>
        </p>

        <!-- Disclaimer -->
        <p style="margin: 24px 0 0 0; font-size: 13px; color: #999; border-top: 1px solid #eee; padding-top: 20px;">
            Se você não solicitou este cadastro ou acha que foi um erro, simplesmente ignore este e-mail.
        </p>
    </div>

    <!-- Rodapé -->
    <div style="background: #2c3e50; color: #ecf0f1; padding: 24px; text-align: center; border-radius: 0 0 8px 8px; font-size: 12px;">
        <p style="margin: 0 0 12px 0;">
            <strong><t t-out="object.company_id.name or ''"/></strong>
        </p>
        <p style="margin: 0; color: #bdc3c7;">
            <t t-if="object.company_id.email">
                <t t-out="object.company_id.email"/> •
            </t>
            <t t-if="object.company_id.phone">
                <t t-out="object.company_id.phone"/>
            </t>
        </p>
        <p style="margin: 12px 0 0 0; font-size: 11px; color: #7f8c8d;">
            © <t t-out="'2024-2025'"/> Wellhub. Todos os direitos reservados.
        </p>
    </div>
</div>
            </field>
        </record>

        <record id="mail_template_wellhub_checkout_paid_admin" model="mail.template">
            <field name="name">Wellhub: aviso interno de pagamento da inscrição</field>
            <field name="model_id" ref="model_wellhub_collaborator"/>
            <field name="subject">Wellhub: {{ object.name }} pagou a assinatura</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted or '' }}</field>
            <field name="email_to">afonso@jgma.com.br</field>
            <field name="auto_delete" eval="False"/>
            <field name="description">Enviado ao administrador quando o checkout Asaas da inscrição é pago (CHECKOUT_PAID).</field>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #2c3e50;">
    <p>O colaborador abaixo concluiu o pagamento no Asaas (checkout da inscrição Wellhub):</p>
    <table style="border-collapse: collapse;">
        <tr><td style="padding: 4px 12px 4px 0;"><strong>Nome</strong></td><td t-out="object.name or ''"/></tr>
        <tr><td style="padding: 4px 12px 4px 0;"><strong>E-mail</strong></td><td t-out="object.email or ''"/></tr>
        <tr><td style="padding: 4px 12px 4px 0;"><strong>Telefone</strong></td><td t-out="object.phone or ''"/></tr>
        <tr><td style="padding: 4px 12px 4px 0;"><strong>CPF/CNPJ</strong></td><td t-out="object.cpf_cnpj or ''"/></tr>
        <tr><td style="padding: 4px 12px 4px 0;"><strong>Valor da cobrança</strong></td><td>R$ <t t-out="'%.2f' % (object.asaas_charge_value_preview or object.subscription_value or 0.0)"/></td></tr>
        <tr><td style="padding: 4px 12px 4px 0;"><strong>Assinatura Asaas</strong></td><td t-out="object.asaas_subscription_id or '—'"/></tr>
        <tr><td style="padding: 4px 12px 4px 0;"><strong>Cliente Asaas</strong></td><td t-out="object.asaas_customer_id or '—'"/></tr>
    </table>
    <p style="margin-top: 16px;">
        <a t-att-href="'%s/odoo/action-afr_wellhub.action_wellhub_collaborator/%s' % (object.get_base_url(), object.id)">Abrir colaborador no Odoo</a>
    </p>
</div>
            </field>
        </record>
    </data>
</odoo>
